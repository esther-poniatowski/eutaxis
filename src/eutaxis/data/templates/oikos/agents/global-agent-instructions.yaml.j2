root: {{ paths.oikos }}

common_sources:
  - path: instructions/global/project-precedence.md
  - path: instructions/global/interaction.md
  - path: instructions/global/file-authority.md
  - path: instructions/global/modular-artifacts.md
  - path: instructions/global/temporary-workspaces.md
  - path: instructions/global/conda-safety.md
  - path: instructions/global/verification.md

task_modules_intro: |
  Load the matching task module before doing the work. Read the file directly
  from disk; do not paraphrase from memory. Load only the modules that apply to
  the current task.
task_modules:
  - id: programming
    title: Programming
    path: {{ paths.oikos }}/instructions/tasks/programming.md
    trigger: when writing, modifying, refactoring, or reviewing source code
    description: Covers typed code, separation of concerns, module boundaries, dependency direction, project structure, tests, and documentation discipline.
  - id: prose-writing
    title: Prose writing
    path: {{ paths.oikos }}/instructions/tasks/prose-writing.md
    trigger: when drafting or revising documentation, articles, presentations, or long-form prose
    description: Covers tone, sentence structure, cross-referencing, and the Hermeneia style rules.
  - id: mathematical-analysis
    title: Mathematical analysis
    path: {{ paths.oikos }}/instructions/tasks/mathematical-analysis.md
    trigger: when performing mathematical reasoning, proofs, or step-by-step derivations
    description: Covers stated assumptions, validity checks, proof and example requirements, and notation discipline.
  - id: conceptual-reasoning
    title: Conceptual reasoning
    path: {{ paths.oikos }}/instructions/tasks/conceptual-reasoning.md
    trigger: when analyzing concepts, comparing alternatives, or structuring explanations
    description: Covers deep-structure analysis, motivation-before-detail, sequencing, comparisons, and source verification.
  - id: git-workflows
    title: Git workflows
    path: {{ paths.oikos }}/instructions/tasks/git-workflows.md
    trigger: when staging, splitting, or rewriting commits
    description: Covers batch staging, commit splitting, staged-diff verification, and safe handling of destructive operations.
  - id: handoff-workflows
    title: Handoff workflows
    path: {{ paths.oikos }}/instructions/tasks/handoff-workflows.md
    trigger: when preparing or consuming a handoff document
    description: Covers handoff scope, progress tracking, synchronization debt, and obsolescence cleanup.

agents:
  - name: global-codex
    enabled: true
    max_bytes: 32768   # Codex `project_doc_max_bytes` default
    target:
      path: {{ codex.global_agents_path }}
      header: |
        # Global Agent Instructions

        <!--
        Generated file. Do not edit directly.
        Source configuration: {{ paths.oikos }}/generated/machine/agents/global-agent-instructions.yaml
        Instruction source root: {{ paths.oikos }}
        -->
      footer: |
        <!--
        Regenerate from the source configuration. Do not edit this file directly.
        -->

  - name: global-claude
    enabled: true
    max_bytes: 32768   # mirror Codex budget for parity
    target:
      path: {{ claude.global_claude_path }}
      header: |
        # Global Claude Code Instructions

        <!--
        Generated file. Do not edit directly.
        Source configuration: {{ paths.oikos }}/generated/machine/agents/global-agent-instructions.yaml
        Instruction source root: {{ paths.oikos }}
        -->
      footer: |
        <!--
        Regenerate from the source configuration. Do not edit this file directly.
        -->
