root: {{ paths.oikos }}

common_sources:
  - path: modules/instructions/global/entrypoint.md
  - path: modules/instructions/global/always/interaction.md
  - path: modules/instructions/global/always/file-authority.md
  - path: modules/instructions/global/always/git-safety.md
  - path: modules/instructions/global/always/verification.md

agents:
  - name: global-codex
    enabled: true
    target:
      path: {{ codex.global_agents_path }}
      header: |
        # Global Agent Instructions

        Generated from oikos modules for {{ machine.label }}.

        Oikos root: {{ paths.oikos }}
      footer: |
        ---
        Generated by eutaxis from oikos.

  - name: global-claude
    enabled: false
    target:
      path: {{ claude.global_claude_path }}
      header: |
        # Global Claude Code Instructions

        Planned output from oikos modules for {{ machine.label }}.

        This target is intentionally disabled until existing Claude Code
        defaults have been reviewed and merged.

        Oikos root: {{ paths.oikos }}
      footer: |
        ---
        Planned by eutaxis from oikos. Disabled by default.
