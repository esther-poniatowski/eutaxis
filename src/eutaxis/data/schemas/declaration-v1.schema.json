{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eutaxis.dev/schemas/declaration-v1.schema.json",
  "title": "Eutaxis declaration contract version 1",
  "type": "object",
  "required": [
    "_schema"
  ],
  "properties": {
    "_schema": {
      "const": "eutaxis:declaration@1",
      "x-kind": "label"
    }
  },
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "https://eutaxis.dev/schemas/declaration-v1.base.schema.json#/$defs/rule-set"
        },
        {
          "properties": {
            "rules": {
              "items": {
                "$ref": "#/$defs/bound-rule"
              },
              "x-kind": "records"
            }
          }
        }
      ]
    },
    {
      "$ref": "#/$defs/bound-rule"
    },
    {
      "$ref": "https://eutaxis.dev/schemas/declaration-v1.base.schema.json#/$defs/procedure"
    },
    {
      "$ref": "https://eutaxis.dev/schemas/declaration-v1.base.schema.json#/$defs/resolution-policy"
    },
    {
      "$ref": "https://eutaxis.dev/schemas/declaration-v1.base.schema.json#/$defs/composition-manifest"
    },
    {
      "$ref": "https://eutaxis.dev/schemas/declaration-v1.base.schema.json#/$defs/evaluator"
    },
    {
      "$ref": "https://eutaxis.dev/schemas/declaration-v1.base.schema.json#/$defs/operation"
    },
    {
      "$ref": "https://eutaxis.dev/schemas/declaration-v1.base.schema.json#/$defs/decision"
    }
  ],
  "$defs": {
    "bound-rule": {
      "allOf": [
        {
          "$ref": "https://eutaxis.dev/schemas/declaration-v1.base.schema.json#/$defs/rule"
        },
        {
          "required": [
            "_schema"
          ],
          "properties": {
            "_schema": {
              "const": "eutaxis:declaration@1",
              "x-kind": "label"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
