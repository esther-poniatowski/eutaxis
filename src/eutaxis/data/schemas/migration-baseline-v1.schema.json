{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eutaxis.dev/schemas/migration-baseline-v1.schema.json",
  "title": "Eutaxis migration baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "id",
    "owner",
    "manifest",
    "migration",
    "expires-at",
    "finding"
  ],
  "properties": {
    "schema-version": {"type": "integer", "const": 1},
    "id": {"$ref": "#/$defs/identifier"},
    "owner": {"$ref": "#/$defs/identifier"},
    "manifest": {"$ref": "#/$defs/identifier"},
    "migration": {"$ref": "#/$defs/identifier"},
    "expires-at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "state", "digest"],
      "properties": {
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "declaration", "criterion"],
          "properties": {
            "kind": {"const": "rule-criterion"},
            "declaration": {"$ref": "#/$defs/identifier"},
            "criterion": {"$ref": "#/$defs/identifier"}
          }
        },
        "state": {"enum": ["violated", "unchecked"]},
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\s)[\\s\\S]+$"
    }
  }
}
