{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eutaxis.dev/schemas/context-facets-v1.base.schema.json",
  "title": "Eutaxis context-facet registry base version 1",
  "type": "object",
  "required": [
    "id",
    "owner",
    "source-revision",
    "facets"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id",
      "x-kind": "label"
    },
    "owner": {
      "$ref": "#/$defs/id",
      "x-kind": "label"
    },
    "source-revision": {
      "type": "string",
      "minLength": 1,
      "x-kind": "text"
    },
    "facets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/context-facet"
      },
      "x-kind": "records"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\s)[\\s\\S]+$"
    },
    "facet-id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[./-][a-z0-9]+)*$"
    },
    "context-facet": {
      "type": "object",
      "required": [
        "id",
        "value-schema"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/facet-id",
          "x-kind": "label"
        },
        "value-schema": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
